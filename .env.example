# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/repo_analyzer

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI (optional — leave empty to use rule-based fallback explanations) ───────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CLONE_BASE_DIR=/tmp/repo_clones
MAX_REPO_SIZE_MB=100

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
