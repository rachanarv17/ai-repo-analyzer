# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
DATABASE_URL=sqlite+aiosqlite:///./repo_analyzer.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI (optional — leave empty to use rule-based fallback explanations) ───────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CLONE_BASE_DIR=./repo_clones
MAX_REPO_SIZE_MB=100

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
